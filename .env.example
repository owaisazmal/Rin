# Copy to `.env` and adjust if your files live elsewhere. `.env` is gitignored;
# this file is the only one that gets committed, and it must never hold real
# values.
#
# Firebase is configured by two files the console generates, not by variables.
# Both are gitignored. They hold the project's public identifiers — an app
# can't hide them, since it ships them — but they stay out of the repo as a
# matter of hygiene. The build reads them from these paths:
#
#   GOOGLE_SERVICES_JSON        google-services.json        (Android)
#   GOOGLE_SERVICE_INFO_PLIST   GoogleService-Info.plist    (iOS)
#
# For EAS builds, upload each as a *file* environment variable under the same
# name (`eas env:create --type file`), so it never passes through a committed
# file either.
#
# The Firebase Admin SDK's service-account JSON is the one real secret. It is
# never needed by this app and belongs nowhere in this project.

GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist
