# Replaces .gitignore for the EAS upload, so its entries are repeated here; an uploaded /ios or /android makes EAS treat the project as bare.
node_modules/
/ios
/android
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
.metro-health-check*
*.tsbuildinfo
.DS_Store
modules/*/android/build/
modules/*/android/.gradle/

# secrets; the Firebase config files reach the builder as EAS file variables
.env
.env.*
!.env.example
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
service-account*.json
*-service-account.json
*-firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# not needed to build
screenshots/
assets/store/
docs/
src/__tests__/
firebase/
firestore-debug.log
jest.config.js
.git/
.claude/
