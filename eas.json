{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.9.0",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-ci": {
      "extends": "production",
      "autoIncrement": false,
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6814057957"
      }
    }
  }
}
